{
  "name": "cluster-jewel-quality-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lab": "tsx src/orchestrator.ts --suite RELEASE",
    "lab:dev": "tsx src/orchestrator.ts --suite DEV",
    "lab:release": "tsx src/orchestrator.ts --suite RELEASE",
    "lab:extended": "tsx src/orchestrator.ts --suite EXTENDED",
    "lab:nightly": "tsx src/orchestrator.ts --suite EXTENDED",
    "lab:legacy-release": "tsx src/runner.ts --scenario release",
    "lab:gate": "tsx src/orchestrator.ts",
    "lab:tag": "tsx src/orchestrator.ts",
    "lab:failed": "tsx src/orchestrator.ts --failed",
    "lab:resume": "tsx src/orchestrator.ts --resume",
    "lab:list": "tsx src/orchestrator.ts --list",
    "lab:typecheck": "tsc --noEmit -p tsconfig.json",
    "lab:visual-fixture": "tsx src/orchestrator.ts --gate D-frozen-policy-flow-renderer",
    "lab:recommend": "tsx src/impactRecommendation.ts",
    "lab:no-fallback-probe": "tsx src/noFallbackProbe.ts",
    "lab:smoke": "tsx src/runner.ts --scenario smoke",
    "lab:methods": "tsx src/runner.ts --scenario methods",
    "lab:objectives": "tsx src/runner.ts --scenario four",
    "lab:responsive": "tsx src/runner.ts --scenario responsive",
    "lab:animation": "tsx src/runner.ts --scenario animation",
    "lab:additional": "tsx src/runner.ts --scenario additional"
  },
  "dependencies": {
    "tsx": "^4.23.5",
    "typescript": "~7.0.2"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}

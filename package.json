{
  "name": "cluster-jewel-research",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "scrape": "tsx scripts/scrape.ts",
    "scrape:poedb": "node scripts/scrape-poedb.mjs",
    "build:trade-stats": "node scripts/build-trade-stats.mjs",
    "price": "tsx scripts/price.ts",
    "test": "vitest run",
    "publish": "npm run scrape && npm run price && node scripts/publish.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "oxlint": "^1.78.0",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
